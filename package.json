{
  "name": "styleforge",
  "version": "0.7.1",
  "description": "Per-author writing-style management via MCP. Works with any language.",
  "main": "server/index.js",
  "type": "module",
  "bin": {
    "styleforge": "./bin/cli.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "STYLEFORGE_HOME=/tmp/styleforge-test node server/smoke-test.js",
    "postinstall": "node bin/postinstall.js",
    "version": "node bin/sync-version.js && git add manifest.json .claude-plugin/marketplace.json .claude-plugin/plugin.json skills/styleforge/SKILL.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/coding-commits/styleforge.git"
  },
  "homepage": "https://github.com/coding-commits/styleforge",
  "keywords": [
    "mcp",
    "writing",
    "style",
    "claude",
    "llm"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
